<div class="banner">
     <%= render"layouts/banner", image: 'gallery/blog/banner.jpg', title: "Blog"  %>
</div>

<p style="color: green"><%= notice %></p>

<% content_for :title, "Posts" %>

<div>
  <%= link_to "New post", new_post_path, class: "button-custom" %>
</div>

<div id="posts">
  <% @posts.each do |post| %>
    <div id="<%= dom_id post %>" class="post">
      <%= link_to post do %>
        <div class="post-image">
          <%= image_tag(post.featured_image.presence || 'default-image.jpg') %>
        </div>
        <div class="post-content">
          <h2><%= post.title %></h2>
          <p><%= truncate(post.content, length: 300) %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
