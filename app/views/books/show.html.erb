<div class="banner">
    <%= render"layouts/banner", image: @book.featured_image, title: @book.title  %>
</div>

<p style="color: green"><%= notice %></p>

<div>
  <%= link_to "Edit this book", edit_book_path(@book) %> |
  <%= link_to "Back to books", books_path %>

  <%= button_to "Destroy this book", @book, method: :delete %>
</div>

<%= render @book %>

<div class="book-show">
  <div class="books-box">
    <%= image_tag @book.featured_image, class: "books-img"  %>
  </div>
  <div class="books-box">
    <p><%= @book.synopsis %></p>
  </div>
</div>

<div class="test" style="margin-bottom: 50px;">
  <% @book.extra_images.each do |img| %>
    <%= image_tag img, width: "330px", height: "330px"  %>
  <% end %>
</div>

<div class="book-tabs">
  <div class="">
    <button class="" onclick="tabulador('Tab1')">Contenido</button>
    <button class="" onclick="tabulador('Tab2')">Sinopsis</button>
    <button class="" onclick="tabulador('Tab3')">Documentacion</button>
  </div>
  <div class="b-tabs">
    <div id="Tab1" class="tab">
      <h2>Contenido</h2>
      <p>Contenido completo del libro/coleccion</p>
      <p><%= @book.content %></p>
    </div>

    <div id="Tab2" class="tab" style="display:none">
      <h2>Sinopsis</h2>
      <p>Sinopsis del producto</p>
      <p><%= @book.synopsis %></p>
    </div>

    <div id="Tab3" class="tab" style="display:none">
      <h2>Documentacion</h2>
      <p>Catálogo de productos y esquemas</p>
      <% if I18n.locale == :es %>
        <% @book.docs.each do |doc| %>
          <%= link_to doc.filename, rails_blob_path(doc, disposition: "attachment") %>
        <% end %>
      <% elsif I18n.locale == :en %>
        <% @book.docs_en.each do |doc| %>
          <%= link_to doc.filename, rails_blob_path(doc, disposition: "attachment") %>
        <% end %>
      <% end %>
    </div>
  </div>

  <script>
  function tabulador(tabName) {
    var i;
    var x = document.getElementsByClassName("tab");
    for (i = 0; i < x.length; i++) {
      x[i].style.display = "none";  
    }
    document.getElementById(tabName).style.display = "block";  
  }
  </script>
</div>